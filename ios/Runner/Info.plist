<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Fit Street</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>fit_street</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- Supported interface orientations -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Performance / input -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Local network (Bonjour) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>This app needs access to devices on your local network to discover nearby services (e.g. casting, local APIs).</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp.</string>
	</array>

	<!-- Privacy usage descriptions (replace text with your app’s reason) -->
	<key>NSCameraUsageDescription</key>
	<string>Fit Street needs camera access to allow you to take profile and progress photos.</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>Fit Street needs microphone access for voice/video sessions with trainers.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Fit Street needs access to your photo library to upload photos for your profile and progress tracking.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Fit Street needs permission to save photos to your library (for exporting progress images).</string>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Fit Street uses your location to show nearby trainers and location-based features.</string>

	<!-- App queries (allow checking for installed apps before opening URLs) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>razorpay</string>
	</array>

</dict>
</plist>
